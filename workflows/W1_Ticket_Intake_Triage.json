    {
      "parameters": {
        "jsCode": "// 1. Récupérer la compétence requise et les données de l'IA\nconst aiOutput = $('Classify-DemandWithAI').first().json.output;\nconst requiredSkill = (aiOutput.required_skill || '').toLowerCase().trim();\n\n// 2. Récupérer la liste des techniciens disponibles\nconst technicians = $input.first().json.results || [];\n\n// 3. Filtrer les techniciens possédant la compétence requise\nconst qualifiedTechs = technicians.filter(tech => {\n  if (!tech.skills || !Array.isArray(tech.skills)) return false;\n  return tech.skills.some(skill => \n    (skill.value || skill).toLowerCase().includes(requiredSkill)\n  );\n});\n\nlet assignedTechnician = null;\nlet tags = '';\n\nif (qualifiedTechs.length > 0) {\n  // 4. Trier par nombre de tickets ouverts croissant (équilibrage de charge)\n  qualifiedTechs.sort((a, b) => (Number(a.open_tickets) || 0) - (Number(b.open_tickets) || 0));\n  assignedTechnician = qualifiedTechs[0];\n} else {\n  // Aucun technicien qualifié disponible -> reprise humaine\n  tags = 'manual_review';\n}\n\nreturn [{\n  json: {\n    category: aiOutput.category,\n    priority: aiOutput.priority,\n    confidence: aiOutput.confidence,\n    summary: aiOutput.summary,\n    required_skill: aiOutput.required_skill,\n    needs_human_review: aiOutput.needs_human_review,\n    tags: tags,\n    action_log: 'triaged',\n    assigned_technician_id: assignedTechnician ? assignedTechnician.id : null,\n    assigned_technician_name: assignedTechnician ? assignedTechnician.name : null,\n    assigned_technician_email: assignedTechnician ? assignedTechnician.email : null,\n    current_open_tickets: assignedTechnician ? (Number(assignedTechnician.open_tickets) || 0) : 0\n  }\n}];\n"
      },
